# Backend routing server (same backend used by the openclaw-plugin)
ROUTING_BASE_URL=https://openclaw-plugin.dev.ent.imbee.io

# Bearer token from POST /api/v1/pair/request — one apiKey per paired WhatsApp
# user. Run `npm run pair` to get one interactively.
ROUTING_API_KEY=imbee_xxx

# Path to the Claude Code CLI binary. Must be installed and already logged in
# (run `claude` once interactively to authenticate before starting the bridge).
CLAUDE_BIN=claude

# Working directory the Claude Code session can read/write. Each paired user
# gets a subdirectory under this path.
CLAUDE_WORKSPACE_ROOT=./workspaces

# Where the phone → claude session id map is persisted.
SESSION_STORE_PATH=./data/sessions.json

# default | acceptEdits | bypassPermissions | plan
# WhatsApp is unattended — if the agent needs tool permission and nobody's at
# the terminal, the turn will stall. `bypassPermissions` keeps it moving but
# means Claude can run any tool unchecked in CLAUDE_WORKSPACE_ROOT. Pick
# consciously.
CLAUDE_PERMISSION_MODE=default

# Max turns the agent may take on a single inbound message. Optional.
CLAUDE_MAX_TURNS=25
