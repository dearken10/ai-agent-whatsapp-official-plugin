{
  "id": "whatsapp-official",
  "name": "WhatsApp Official API by imBee",
  "version": "0.1.18",
  "description": "Official WhatsApp Business API for your AI agent — no Meta verification, no server setup. Pair via QR in 2 minutes using imBee's verified shared number (free), or upgrade to a dedicated branded number for enterprise use.",
  "author": "imBee Limited",
  "capabilities": ["channel"],
  "channels": ["whatsapp-official"],
  "channelId": "whatsapp-official",
  "setupWizard": true,
  "entryPoint": "./index.ts",
  "configSchema": {
    "title": "Official WhatsApp API Channel Config",
    "type": "object",
    "properties": {
      "routingBaseUrl": {
        "type": "string",
        "description": "Routing server base URL, e.g. http://localhost:28080",
        "default": "http://localhost:28080"
      },
      "instanceId": {
        "type": "string",
        "description": "Unique OpenClaw instance identifier"
      },
      "apiKey": {
        "type": "string",
        "description": "Bearer token returned by POST /api/v1/pair/request (store via OpenClaw secrets when available)"
      },
      "allowFrom": {
        "type": "array",
        "items": { "type": "string" },
        "description": "E.164 allowlist for inbound WhatsApp senders"
      },
      "defaultTo": {
        "type": "string",
        "description": "Optional default outbound peer (E.164)"
      },
      "dmPolicy": {
        "type": "string",
        "enum": ["open", "pairing", "allowlist", "disabled"],
        "default": "open"
      },
      "groupPolicy": {
        "type": "string",
        "enum": ["open", "disabled", "allowlist"],
        "default": "disabled"
      }
    },
    "required": []
  },
  "channelConfigs": {
    "whatsapp-official": {
      "label": "WhatsApp Official API by imBee",
      "description": "Managed WhatsApp Cloud API channel via imBee routing (pairing + WebSocket inbound).",
      "schema": {
        "type": "object",
        "properties": {
          "routingBaseUrl": {
            "type": "string",
            "description": "Routing server base URL, e.g. http://localhost:28080",
            "default": "http://localhost:28080"
          },
          "instanceId": { "type": "string" },
          "apiKey": { "type": "string" },
          "allowFrom": { "type": "array", "items": { "type": "string" } },
          "defaultTo": { "type": "string" },
          "dmPolicy": {
            "type": "string",
            "enum": ["open", "pairing", "allowlist", "disabled"],
            "default": "open"
          },
          "groupPolicy": {
            "type": "string",
            "enum": ["open", "disabled", "allowlist"],
            "default": "disabled"
          }
        },
        "required": []
      }
    }
  }
}
